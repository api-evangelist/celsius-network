              "type": "apikey",
              "key": "X-Cel-Partner-Token",
              "value": "{{X-Cel-Partner-Token}}",
              "placement": "header"
            }
          },
          "docs": "Creates a user in the Celsius system on behalf of a Segmented Integration partner and returns the `userId`. The supplied `user_token` is subsequently used as the user secret (`X-Cel-User-Token`)."
        },
        {
          "info": {
            "name": "Update the user's email address",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://wallet-api.celsius.network/users",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "email",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates the email address of the authenticated user."
        },
        {
          "info": {
            "name": "Update a partner user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://wallet-api.celsius.network/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
