{
  "opencollection": "1.0.0",
  "info": {
    "name": "Celsius Partner Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Cel-Partner-Token",
      "value": "{{X-Cel-Partner-Token}}",
      "placement": "header"
    }
  },
